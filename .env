# Billing service
BILLING_HOST=0.0.0.0
BILLING_PORT=5001
BILLING_DEBUG=false
BILLING_TESTING=false

# Billing PostgreSQL
BILLING_DB_HOST=localhost
BILLING_DB_PORT=5432
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_password

# RabbitMQ
BILLING_RABBITMQ_HOST=192.168.56.12
BILLING_RABBITMQ_PORT=5672
BILLING_RABBITMQ_USER=billing_user
BILLING_RABBITMQ_PASSWORD=billing_password
BILLING_RABBITMQ_QUEUE=billing_queue
BILLING_RABBITMQ_HEARTBEAT=30
BILLING_RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=30
BILLING_CONSUMER_RECONNECT_DELAY=5

# inventory service
INVENTORY_HOST=0.0.0.0
INVENTORY_PORT=8080

# inventory PostgreSQL
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=movies_db
INVENTORY_DB_USER=movies_user
INVENTORY_DB_PASSWORD=movies_password

# gateway service
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
INVENTORY_API_URL=http://192.168.56.11:8080
