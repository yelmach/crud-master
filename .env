# Billing service
BILLING_HOST=0.0.0.0
BILLING_PORT=5001
BILLING_DEBUG=false
BILLING_TESTING=false

# Billing PostgreSQL
BILLING_DB_HOST=localhost
BILLING_DB_PORT=5432
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_password
# Optional full SQLAlchemy URI override
# BILLING_DATABASE_URI=postgresql://billing_user:billing_password@localhost:5432/billing_db

# RabbitMQ
BILLING_RABBITMQ_HOST=localhost
BILLING_RABBITMQ_PORT=5672
BILLING_RABBITMQ_USER=guest
BILLING_RABBITMQ_PASSWORD=guest
BILLING_RABBITMQ_QUEUE=billing_queue
BILLING_RABBITMQ_HEARTBEAT=30
BILLING_RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=30
BILLING_CONSUMER_RECONNECT_DELAY=5
